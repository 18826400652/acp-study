{
  "name": "acp-study-app",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:cov": "node --test --experimental-test-coverage --test-coverage-include=js/scoring.js --test-coverage-include=js/exam.js --test-coverage-include=js/progress.js --test-coverage-include=js/storage.js --test-coverage-include=js/router.js --test-coverage-include=scripts/validate-lib.mjs --test-coverage-include=scripts/serve-lib.mjs --test-coverage-lines=80 \"tests/unit/**/*.test.mjs\"",
    "validate": "node scripts/validate-data.mjs",
    "e2e": "playwright test",
    "size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
